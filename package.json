{
  "name": "@mango-write/surveys",
  "private": true,
  "version": "0.1.0",
  "description": "Research survey authoring, collection, and statistical analysis plugin",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.20.0",
  "exports": {
    ".": "./src/index.ts",
    "./core": {
      "mango-source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./contracts": {
      "mango-source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./server": "./src/server/index.ts",
    "./research": {
      "mango-source": "./src/research/index.ts",
      "types": "./dist/research/index.d.ts",
      "default": "./dist/research/index.js"
    },
    "./ai": "./src/ai/index.ts",
    "./vue": "./src/vue/index.ts",
    "./mount": "./src/vue/mount.ts",
    "./dsh": {
      "mango-source": "./src/dsh/index.ts",
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./adapters": "./src/adapters/index.ts",
    "./ports": "./src/ports.ts"
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json",
    "prepare": "tsc6 -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@echarts-x/custom-word-cloud": "1.0.1",
    "@mango-write/ui-core": "git+https://github.com/mango-write/mango-write-ui.git#d8dc5673ffa41f40c9fe330b18be8c6e77f05db2&path:packages/core",
    "@mango-write/ui-vue": "git+https://github.com/mango-write/mango-write-ui.git#d8dc5673ffa41f40c9fe330b18be8c6e77f05db2&path:packages/vue",
    "dompurify": "^3.5.0",
    "echarts": "^6.1.0",
    "hono": "^4.13.21",
    "jsdom": "^31.0.1",
    "ml-matrix": "6.15.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.4",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "lucide-vue-next": "^1.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.5",
    "vue-tsc": "3.3.13"
  },
  "pnpm": {
    "overrides": {
      "@mango-write/ui-core": "git+https://github.com/mango-write/mango-write-ui.git#d8dc5673ffa41f40c9fe330b18be8c6e77f05db2&path:packages/core",
      "@mango-write/ui-vue": "git+https://github.com/mango-write/mango-write-ui.git#d8dc5673ffa41f40c9fe330b18be8c6e77f05db2&path:packages/vue"
    }
  },
  "sideEffects": false,
  "engines": {
    "dsh": ">=0.2.2-rc.4",
    "node": ">=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-sdk-app"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": true
    },
    "client": {
      "platform": "web",
      "external": [
        "@mango-write/surveys/mount"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mango-write/mango-write-surveys.git"
  },
  "bugs": {
    "url": "https://github.com/mango-write/mango-write-surveys/issues"
  },
  "homepage": "https://github.com/mango-write/mango-write-surveys#readme"
}
