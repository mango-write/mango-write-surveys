{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/contracts/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/core/test-fixtures.ts"]
}
