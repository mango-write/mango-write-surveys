# 独立站 PostgreSQL 连接（PG 13+；库需先存在，表结构由 db:init 幂等创建）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mango_surveys

# 选项图媒体目录（相对路径基于 examples/standalone 运行目录）
MEDIA_DIR=./data/surveys-media

# HTTP 端口
PORT=3100

# 管理面登录密码（务必改成 ≥32 位随机值）
ADMIN_PASSWORD=change-me-please

# 构建前设置：实际部署版本的完整对应源码（修改版须换成自己的 tag/源码归档）。
VITE_SURVEYS_SOURCE_URL=https://github.com/mango-write/mango-write-surveys/tree/v0.1.0

# AI 建卷（可选）：OpenAI 兼容端点（/v1/chat/completions 形态）。三项都配置才启用，
# 缺省时管理面 AI 按钮提示未配置。
# SURVEYS_AI_URL=https://api.example.com/v1/chat/completions
# SURVEYS_AI_API_KEY=sk-...
# SURVEYS_AI_MODEL=deepseek-chat
# SURVEYS_AI_TIMEOUT_MS=60000
